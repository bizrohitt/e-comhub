# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Every key here is read in config/settings/. Unknown keys are ignored.

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-64-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full public origin, no trailing slash. Used for canonical URLs, sitemap and share links.
SITE_URL=http://localhost:8000
SITE_NAME=e-comhub

# --- Database ---------------------------------------------------------------
# SQLite by default (ADR-010). Path is relative to the project root.
DATABASE_PATH=db.sqlite3

# --- Security (prod only) ---------------------------------------------------
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
# Admin lives at a non-obvious path in prod. No leading or trailing slash.
ADMIN_URL_PREFIX=admin

# --- Rate limits (requests per IP per window, used by server-mode tools) -----
RATE_LIMIT_RUN_PER_MINUTE=30
RATE_LIMIT_LEADS_PER_HOUR=10

# --- Email (needed from P4: double opt-in) ----------------------------------
# Dev prints to the console; set a real backend in prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@example.com

# --- Feature flags (DB-backed from P2; env is the bootstrap default) --------
FEATURE_LLM_TOOLS=false
FEATURE_ADS=false
FEATURE_EMBEDS=false
